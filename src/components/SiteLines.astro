<div class="site-lines" aria-hidden="true">
  {Astro.url.pathname === '/' && (
    <svg class="site-lines__packet" viewBox="0 0 1440 1800" preserveAspectRatio="none" fill="none" focusable="false">
      <use href="/photos/site-lines.svg#packet-route" />
    </svg>
  )}
</div>

<style>
  .site-lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .site-lines::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/photos/site-lines.svg');
    background-size: 100% 1800px;
    background-repeat: repeat-y;
    opacity: 0.18;
  }

  .site-lines__packet {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1800px;
  }

  .site-lines__packet use {
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 0.001 1;
    opacity: 0;
  }

  @keyframes send-packet {
    0% { stroke-dashoffset: 0; opacity: 0; }
    5%, 90% { opacity: 1; }
    100% { stroke-dashoffset: -1; opacity: 0; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-lines__packet use { animation: send-packet 2800ms linear 1 both; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-lines__packet { display: none; }
  }

  @media (max-width: 640px) {
    .site-lines::before { opacity: 0.1; }
  }
</style>
