---
import { useTranslations } from '../lib/translate';

const { t } = useTranslations('en');
const tr = useTranslations('fr');

const featured = [
  {
    title: 'Nostroguard',
    desc: 'projects.pNostroguard',
    stack: ['PHP', 'JavaScript', 'Docker'],
    repo: 'https://github.com/7n4xt/Nostroguard',
    img: '/photos/Nostroguard-preview.png',
  },
  {
    title: 'Vault-CLI',
    desc: 'projects.pVaultCli',
    stack: ['Python'],
    repo: 'https://github.com/7n4xt/Vault-CLI',
    img: '/photos/Vault-CLI-preview.png',
  },
  {
    title: 'Hangman Web',
    desc: 'projects.pHangmanWeb',
    stack: ['Go', 'HTML', 'CSS'],
    repo: 'https://github.com/7n4xt/Les-Swappers',
    img: '/photos/hang-engine-preview.png',
  },
  {
    title: 'Ymmoblier',
    desc: 'projects.pYmmoblier',
    stack: ['PHP', 'MySQL', 'MVC'],
    repo: 'https://github.com/7n4xt/fil-rouge-b2',
    img: '/photos/Ymmobilier-preview.png',
  },
  {
    title: 'Forum-Go',
    desc: 'projects.pForumGo',
    stack: ['Go', 'MySQL'],
    repo: 'https://github.com/7n4xt/Forum-go',
    img: '/photos/forum-preview.png',
  },
  {
    title: 'E-Dealership',
    desc: 'projects.pEDealership',
    stack: ['JavaScript', 'HTML', 'CSS'],
    repo: 'https://github.com/7n4xt/e-dealership',
    img: '/photos/e-dealership-preview.png',
  },
  {
    title: 'Reseau Linux B2',
    desc: 'projects.pReseauLinux',
    stack: ['Linux', 'Nginx', 'WireGuard', 'MariaDB'],
    repo: 'https://github.com/Alexandre-ynov/Reseau_linux_B2',
    img: '/photos/linux-networking-preview.png',
  },
  {
    title: 'Papery',
    desc: 'projects.pPapery',
    stack: ['HTML', 'CSS', 'JavaScript'],
    repo: 'https://github.com/7n4xt/Papery',
    img: '/photos/papery-preview.png',
  },
  {
    title: 'Hangman CLI',
    desc: 'projects.pHangmanCli',
    stack: ['Go'],
    repo: 'https://github.com/7n4xt/Hangman',
    img: '/photos/hangman-preview.png',
  },
] as const;
---

<section class="projects section" id="projects">
  <div class="container">
    <header class="section__head" data-reveal>
      <p class="section__label mono" data-en={t('projects.label')} data-fr={tr.t('projects.label')}>{t('projects.label')}</p>
      <h2 class="section__title" data-en={t('projects.title')} data-fr={tr.t('projects.title')}>{t('projects.title')}</h2>
      <p class="section__subtitle" data-en={t('projects.subtitle')} data-fr={tr.t('projects.subtitle')}>
        {t('projects.subtitle')}
      </p>
    </header>

    <div class="projects__grid">
      {featured.map((p, i) => (
        <a href={p.repo} target="_blank" rel="noopener" class="project card" data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
          <div class="project__media">
            <img src={p.img} alt={`${p.title} preview`} loading="lazy" />
          </div>
          <div class="project__body">
            <h3 class="project__title">{p.title}</h3>
            <p class="project__desc" data-en={t(p.desc)} data-fr={tr.t(p.desc)}>{t(p.desc)}</p>
            <div class="project__stack">
              {p.stack.map((s) => (
                <span class="project__tag mono">{s}</span>
              ))}
            </div>
            <span class="project__source" data-en="View source code" data-fr="Voir le code source">View source code</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .section__head {
    margin-bottom: 3.5rem;
    max-width: 760px;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: inherit;
  }

  .project:hover {
    transform: translateY(-3px);
  }

  .project:hover .project__overlay {
    opacity: 1;
  }

  .project__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border-subtle);
  }

  .project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project:hover .project__media img {
    transform: scale(1.05);
  }

  .project__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 1rem;
    background: linear-gradient(180deg, transparent 40%, rgba(16, 19, 26, 0.85));
    color: var(--accent);
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity var(--transition);
  }

  .project__body {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .project__title {
    font-size: 1.15rem;
  }

  .project__source { color: var(--accent); font-size: 0.9rem; font-weight: 600; margin-top: 0.75rem; }

  .project__desc {
    color: var(--text-secondary);
    font-size: 0.93rem;
    flex: 1;
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .project__tag {
    font-size: 0.72rem;
    color: var(--nord9);
    background: rgba(129, 161, 193, 0.12);
    border: 1px solid var(--border-subtle);
    padding: 0.18rem 0.6rem;
    border-radius: var(--radius-full);
  }

  @media (max-width: 980px) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
