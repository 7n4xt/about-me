---
const featured = [
  {
    title: 'Nostroguard',
    desc: 'Live SaaS cybersecurity training platform — interactive security exercises delivered through a web platform.',
    stack: ['PHP', 'JavaScript', 'Docker'],
    repo: 'https://github.com/7n4xt/Nostroguard',
    img: '/photos/forum-preview.png',
  },
  {
    title: 'Honeypot + SIEM Lab',
    desc: 'Deceptive honeypot deployment feeding a Wazuh SIEM for real-time intrusion detection and alerting.',
    stack: ['Wazuh', 'Linux', 'Bash'],
    repo: 'https://github.com/7n4xt/honeypot-siem',
    img: '/photos/hang-engine-preview.png',
  },
  {
    title: 'Vault-CLI',
    desc: 'Encrypted local password manager built in Python — secrets never leave your machine.',
    stack: ['Python'],
    repo: 'https://github.com/7n4xt/Vault-CLI',
    img: '/photos/hangman-preview.png',
  },
  {
    title: 'Homelab',
    desc: 'Proxmox-based lab running Grafana, Samba, Pi-hole and Navidrome — my personal infrastructure playground.',
    stack: ['Proxmox', 'Grafana', 'Self-hosted'],
    repo: 'https://github.com/7n4xt/homelab',
    img: '/photos/papery-preview.png',
  },
  {
    title: 'E-Dealership',
    desc: 'Web application for a premium performance car dealership — university project to sharpen JS skills.',
    stack: ['JavaScript', 'HTML', 'CSS'],
    repo: 'https://github.com/7n4xt/e-dealership',
    img: '/photos/e-dealership-preview.png',
  },
  {
    title: 'Forum-Go',
    desc: 'Modern discussion platform built with Go — search, categories, pagination and an admin panel.',
    stack: ['Go', 'MySQL'],
    repo: 'https://github.com/7n4xt/Forum-go',
    img: '/photos/forum-preview.png',
  },
];
---

<section class="projects section" id="projects">
  <div class="container">
    <header class="section__head" data-reveal>
      <p class="section__label mono">// projects</p>
      <h2 class="section__title">Featured projects</h2>
      <p class="section__subtitle">
        A selection of what I've built and deployed — from security labs to full web platforms.
        The rest are pulled live from GitHub below.
      </p>
    </header>

    <div class="projects__grid">
      {featured.map((p, i) => (
        <a href={p.repo} target="_blank" rel="noopener" class="project card" data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
          <div class="project__media">
            <img src={p.img} alt={`${p.title} preview`} loading="lazy" />
            <div class="project__overlay mono">view source →</div>
          </div>
          <div class="project__body">
            <h3 class="project__title">{p.title}</h3>
            <p class="project__desc">{p.desc}</p>
            <div class="project__stack">
              {p.stack.map((s) => (
                <span class="project__tag mono">{s}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .section__head {
    margin-bottom: 3.5rem;
    max-width: 760px;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: inherit;
  }

  .project:hover {
    transform: translateY(-6px);
  }

  .project:hover .project__overlay {
    opacity: 1;
  }

  .project__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border-subtle);
  }

  .project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project:hover .project__media img {
    transform: scale(1.05);
  }

  .project__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 1rem;
    background: linear-gradient(180deg, transparent 40%, rgba(16, 19, 26, 0.85));
    color: var(--accent);
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity var(--transition);
  }

  .project__body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .project__title {
    font-size: 1.15rem;
  }

  .project__desc {
    color: var(--text-secondary);
    font-size: 0.93rem;
    flex: 1;
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .project__tag {
    font-size: 0.72rem;
    color: var(--nord9);
    background: rgba(129, 161, 193, 0.12);
    border: 1px solid var(--border-subtle);
    padding: 0.18rem 0.6rem;
    border-radius: var(--radius-full);
  }

  @media (max-width: 980px) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }
  }
</style>