          <div class="t-line"><span class="t-prompt">abdulmalek@homelab:</span><span class="t-dir">~$</span> <span class="t-cursor">▊</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-line"></span>
  </div>
</section>

<script>
  import { currentLang, watchLang } from '../lib/lang-store';

  const rolesByLang: Record<'en' | 'fr', string[]> = {
    en: [
      'networking & infra student',
      'working toward CCNA',
      'homelab tinkerer',
      'cybersecurity background',
      'linux enjoyer',
    ],
    fr: [
      'étudiant réseaux & infra',
      'préparation CCNA',
      'bricoleur de homelab',
      'parcours cybersécurité',
      'amateur de linux',
    ],
  };

  const el = document.getElementById('hero-typing')!;
  let roles = rolesByLang[currentLang()];
  let roleIdx = 0;
  let charIdx = 0;
  let deleting = false;

  // Restart the loop cleanly when the language changes.
  watchLang((lang) => {
    roles = rolesByLang[lang];
    roleIdx = 0;
    charIdx = 0;
    deleting = false;
    el.textContent = '';
  });

  function tick() {
    const word = roles[roleIdx] ?? '';
    charIdx += deleting ? -1 : 1;
    el.textContent = word.slice(0, Math.max(0, charIdx));
    let delay = deleting ? 45 : 85;
    if (!deleting && charIdx === word.length) {
      delay = 1700;
      deleting = true;
    } else if (deleting && charIdx === 0) {
      deleting = false;
      roleIdx = (roleIdx + 1) % roles.length;
      delay = 350;
    }
    setTimeout(tick, delay);
  }
  tick();

  const clock = document.getElementById('hero-clock');
  function updateClock() {
    const now = new Date();
    clock!.textContent = now.toLocaleTimeString('en-GB', { hour12: false });
  }
  updateClock();
  setInterval(updateClock, 1000);
</script>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: var(--nav-height);
    position: relative;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
    padding-block: 3rem;
  }

  .hero__status {
    display: flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--success);
    background: rgba(163, 190, 140, 0.08);
    border: 1px solid rgba(163, 190, 140, 0.25);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  /* Keep "Marseille, France" on one line; let the translated status wrap. */
  .hero__loc {
    white-space: nowrap;
  }

  .hero__status > span:last-child {
    white-space: nowrap;
  }

  /* Below this width the pill can't hold clock + tz + status on one line. */
  .hero__tz {
    display: none;
  }

  .hero__pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 0 rgba(163, 190, 140, 0.6);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(163, 190, 140, 0.55); }
    70% { box-shadow: 0 0 0 9px rgba(163, 190, 140, 0); }
    100% { box-shadow: 0 0 0 0 rgba(163, 190, 140, 0); }
  }

  .hero__tz, .hero__loc {
    color: var(--text-muted);
  }

  .hero__title {
    font-size: clamp(2.2rem, 5.5vw, 3.9rem);
    margin-bottom: 1rem;
  }

  .hero__name {
    background: linear-gradient(120deg, var(--nord8), var(--nord9));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__typing {
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    color: var(--nord13);
    min-height: 2.2rem;
    margin-bottom: 1.4rem;
  }

  .hero__prompt {
    color: var(--nord14);
  }

  .hero__caret {
    color: var(--accent);
    animation: blink 1s steps(2, start) infinite;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .hero__sub {
    color: var(--text-secondary);
    font-size: 1.08rem;
    max-width: 56ch;
    margin-bottom: 2rem;
  }

  .hero__sub strong {
    color: var(--text-primary);
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  /* Secondary CV link: small note, not a button */
  .btn--cv-en {
    border-style: dashed;
    font-size: 0.8rem;
    padding: 0.5rem 0.9rem;
  }

  .hero__badges {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-size: 0.82rem;
    transition: all var(--transition);
  }

  .hero__badge:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  /* ---- Terminal card ---- */
  .hero__terminal {
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
  }

  .hero__terminal:hover {
    transform: translateY(-4px);
  }

  .hero__terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(16, 19, 26, 0.5);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .dot--r { background: var(--nord11); }
  .dot--y { background: var(--nord13); }
  .dot--g { background: var(--nord14); }

  .hero__terminal-title {
    margin-left: 0.6rem;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .hero__terminal-body {
    padding: 1.3rem 1.4rem;
    font-size: 0.88rem;
    line-height: 2;
    overflow: hidden;
  }

  .t-line {
    white-space: nowrap;
  }

  .t-prompt-line {
    margin-bottom: 0.5rem;
  }

  .t-fastfetch {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 0.4rem;
  }

  .t-ascii {
    margin: 0;
    padding: 0;
    line-height: 1.35;
    font-size: 0.62rem;
    color: var(--nord8);
    flex-shrink: 0;
    user-select: none;
  }

  .t-ascii .c2 {
    color: var(--nord6);
  }

  .t-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0.15rem;
    min-width: 0;
  }

  .t-info .t-line {
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .t-prompt {
    color: var(--nord14);
  }

  .t-dir {
    color: var(--accent);
  }

  .t-dim {
    color: var(--text-muted);
  }

  .t-ok {
    color: var(--success);
  }

  .t-cursor {
    color: var(--accent);
    animation: blink 1s steps(2, start) infinite;
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 38px;
    border: 2px solid var(--nord3);
    border-radius: var(--radius-full);
    display: flex;
    justify-content: center;
    padding-top: 7px;
  }

  .hero__scroll-line {
    width: 3px;
    height: 9px;
    border-radius: var(--radius-full);
    background: var(--accent);
    animation: scroll-hint 1.8s ease-in-out infinite;
  }

  @keyframes scroll-hint {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(12px); opacity: 0; }
    100% { transform: translateY(0); opacity: 0; }
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-block: 4rem 2rem;
    }
    .hero__scroll { display: none; }

    .t-fastfetch {
      flex-direction: column;
      gap: 0.5rem;
    }

    .t-ascii {
      font-size: 0.5rem;
      line-height: 1.2;
    }

    .t-info .t-line {
      font-size: 0.72rem;
    }
  }

  @media (max-width: 560px) {
    .t-line { white-space: normal; }
  }
</style>
