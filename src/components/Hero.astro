---
import { SITE } from '../lib/site';
import { useTranslations } from '../lib/translate';

const { t } = useTranslations('en');
const tr = useTranslations('fr');
---

<section class="hero" id="home">
  <div class="hero__grid container">
    <div class="hero__content">
      <p class="hero__status mono" data-reveal>
        <span class="hero__pulse" aria-hidden="true"></span>
        <span id="hero-clock">--:--:--</span> <span class="hero__tz">UTC+02:00</span> · <span class="hero__loc">{SITE.location}</span> ·
        <span data-en={t('hero.systemOnline')} data-fr={tr.t('hero.systemOnline')}>{t('hero.systemOnline')}</span>
      </p>

      <h1 class="hero__title" data-reveal>
        <span data-en={t('hero.greeting')} data-fr={tr.t('hero.greeting')}>{t('hero.greeting')}</span>
        <span class="hero__name">Abdulmalek Esughi</span>
      </h1>

      <p class="hero__typing mono" data-reveal>
        <span class="hero__prompt" aria-hidden="true">$&nbsp;</span>
        <span id="hero-typing"></span><span class="hero__caret" aria-hidden="true">▊</span>
      </p>

      <p class="hero__sub" data-reveal>
        <span data-en={t('hero.sub1')} data-fr={tr.t('hero.sub1')}>{t('hero.sub1')}</span>
        <strong>Marseille, France</strong><span
          data-en={t('hero.sub2')}
          data-fr={tr.t('hero.sub2')}>{t('hero.sub2')}</span>
        <strong>CCNA</strong>
        <span data-en={t('hero.sub3')} data-fr={tr.t('hero.sub3')}>{t('hero.sub3')}</span>
      </p>

      <div class="hero__actions" data-reveal>
        <a class="btn btn--primary" href="/#projects">
          <span class="icon" aria-hidden="true">›</span>
          <span data-en={t('hero.viewWork')} data-fr={tr.t('hero.viewWork')}>{t('hero.viewWork')}</span>
        </a>
        <a class="btn btn--ghost" href="/blog">
          <span class="icon" aria-hidden="true">§</span>
          <span data-en={t('hero.readBlog')} data-fr={tr.t('hero.readBlog')}>{t('hero.readBlog')}</span>
        </a>
        <a class="btn btn--ghost" href="/files/ESUGHI-Abdulmalek-CV.pdf" download>
          <span class="icon" aria-hidden="true">↓</span>
          <span data-en={t('hero.downloadCV')} data-fr={tr.t('hero.downloadCV')}>{t('hero.downloadCV')}</span>
        </a>
      </div>

      <div class="hero__badges" data-reveal>
        <a href={SITE.social.github} target="_blank" rel="noopener" class="hero__badge card">
          <span class="mono">~/github/7n4xt</span>
        </a>
        <a href={SITE.social.linkedin} target="_blank" rel="noopener" class="hero__badge card">
          <span class="mono">~/linkedin/abdulmalek</span>
        </a>
      </div>
    </div>

    <div class="hero__visual" data-reveal>
      <div class="hero__terminal card">
        <div class="hero__terminal-bar">
          <span class="dot dot--r"></span>
          <span class="dot dot--y"></span>
          <span class="dot dot--g"></span>
          <span class="hero__terminal-title mono">7n4xt@homelab: ~</span>
        </div>
        <div class="hero__terminal-body mono">
          <div class="t-line t-prompt-line"><span class="t-prompt">abdulmalek@homelab:</span><span class="t-dir">~$</span> fastfetch</div>
          <div class="t-fastfetch">
            <pre class="t-ascii" aria-hidden="true"><span class="c1">             .',;::::;,'.
