---
import { SITE } from '../lib/site';
import { useTranslations } from '../lib/translate';
import Terminal from './Terminal.astro';
const { t } = useTranslations('en');
const tr = useTranslations('fr');
---

<section class="hero" id="home">
  <div class="hero__grid container">
    <div class="hero__content">
      <p class="hero__location"><span aria-hidden="true"></span>{SITE.location}</p>
      <h1><span class="hero__greeting" data-en={t('hero.greeting')} data-fr={tr.t('hero.greeting')}>{t('hero.greeting')}</span>Abdulmalek<br />Esughi.</h1>
      <p class="hero__role" data-en="Networking & infrastructure student" data-fr="Étudiant en réseaux et infrastructure">Networking & infrastructure student</p>
      <p class="hero__sub" data-en="I build homelabs, harden systems, and learn by taking things apart. Cybersecurity background. Working toward the CCNA." data-fr="Je monte des homelabs, je sécurise des systèmes et j’apprends en démontant les choses. Un parcours en cybersécurité. Le CCNA en préparation.">I build homelabs, harden systems, and learn by taking things apart. Cybersecurity background. Working toward the CCNA.</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/#projects"><span data-en={t('hero.viewWork')} data-fr={tr.t('hero.viewWork')}>{t('hero.viewWork')}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6" /></svg></a>
        <a class="btn btn--ghost" href="/files/ESUGHI-Abdulmalek-CV.pdf" download><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 16v5h14v-5" /></svg><span data-en={t('hero.downloadCV')} data-fr={tr.t('hero.downloadCV')}>{t('hero.downloadCV')}</span></a>
      </div>
      <div class="hero__links"><a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a><a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a><a href="/blog" data-en={t('hero.readBlog')} data-fr={tr.t('hero.readBlog')}>{t('hero.readBlog')}</a></div>
    </div>
    <Terminal />
  </div>
</section>

<style>
  .hero { padding-block: calc(var(--nav-height) + 5rem) 5rem; }
  .hero__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; align-items: center; gap: 4rem; }
  .hero__content { min-width: 0; }
  .hero__location { display: flex; align-items: center; gap: 0.6rem; color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.75rem; }
  .hero__location > span { width: 7px; height: 7px; background: var(--success); border-radius: 50%; flex-shrink: 0; }
  h1 { font-size: clamp(3rem, 6vw, 5rem); line-height: 1.04; letter-spacing: -0.055em; }
  .hero__greeting { display: block; color: var(--text-secondary); font-size: 1.1rem; letter-spacing: 0; font-weight: 500; margin-bottom: 0.85rem; }
  .hero__role { margin-top: 1.5rem; font-size: clamp(1.15rem, 2vw, 1.4rem); color: var(--accent); font-weight: 500; }
  .hero__sub { margin-top: 1rem; max-width: 48ch; color: var(--text-secondary); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero__links { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 1.25rem; }
  .hero__links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-secondary); font-size: 0.9rem; }
  .hero__links a:hover { color: var(--accent); }
  @media (max-width: 900px) { .hero__grid { grid-template-columns: 1fr; gap: 3rem; } .hero { padding-block: calc(var(--nav-height) + 3rem) 3rem; } }
  @media (max-width: 400px) { .hero__actions .btn { width: 100%; } }
</style>
