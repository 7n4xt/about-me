---
import { SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__blurb">
        <p class="footer__brand mono">$ whoami</p>
        <p>
          {SITE.author} — {SITE.tagline}. From Libya, based in {SITE.location}.
          Always building, always breaking things to understand them.
        </p>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading mono">Navigate</h4>
        <a href="/#home">Home</a>
        <a href="/#about">About</a>
        <a href="/#projects">Projects</a>
        <a href="/blog">Blog</a>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading mono">Connect</h4>
        <a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a>
        <a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={`mailto:${SITE.email}`}>Email</a>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading mono">Reach out</h4>
        <a href={`mailto:${SITE.email}`} class="mono">{SITE.email}</a>
        <span class="footer__muted mono">discord: {SITE.social.discord}</span>
        <span class="footer__muted">{SITE.location}</span>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="mono">&copy; {year} {SITE.author} — 7n4xt.</p>
      <p class="mono">Built with <span class="footer__heart">Astro</span> &amp; the Nord palette.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding-block: 4.5rem 2.5rem;
    background: linear-gradient(180deg, transparent, rgba(16, 19, 26, 0.6));
    scroll-margin-top: 0;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.4fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer__blurb p {
    color: var(--text-secondary);
    max-width: 40ch;
  }

  .footer__brand {
    color: var(--accent);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer__col a {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .footer__col a:hover {
    color: var(--accent);
  }

  .footer__heading {
    color: var(--text-primary);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .footer__muted {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .footer__heart {
    color: var(--nord8);
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
