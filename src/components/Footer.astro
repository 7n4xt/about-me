---
import { SITE } from '../lib/site';
import { useTranslations } from '../lib/translate';

const { t } = useTranslations('en');
const tr = useTranslations('fr');

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__blurb">
        <p class="footer__brand mono">$ whoami</p>
        <p>
          {SITE.author}
          <span data-en={t('footer.blurb1')} data-fr={tr.t('footer.blurb1')}>{t('footer.blurb1')}</span>
          <span data-en={SITE.tagline} data-fr="Étudiant en réseaux & infrastructure">{SITE.tagline}</span>.
          <span data-en={t('footer.blurb2')} data-fr={tr.t('footer.blurb2')}>{t('footer.blurb2')}</span>
          {SITE.location}.
          <span data-en={t('footer.blurb3')} data-fr={tr.t('footer.blurb3')}>{t('footer.blurb3')}</span>
        </p>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading mono" data-en={t('footer.navigate')} data-fr={tr.t('footer.navigate')}>{t('footer.navigate')}</h4>
        <a href="/#home" data-en={t('nav.home')} data-fr={tr.t('nav.home')}>{t('nav.home')}</a>
        <a href="/#about" data-en={t('nav.about')} data-fr={tr.t('nav.about')}>{t('nav.about')}</a>
        <a href="/#projects" data-en={t('nav.projects')} data-fr={tr.t('nav.projects')}>{t('nav.projects')}</a>
        <a href="/blog" data-en={t('nav.blog')} data-fr={tr.t('nav.blog')}>{t('nav.blog')}</a>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading mono" data-en={t('footer.connect')} data-fr={tr.t('footer.connect')}>{t('footer.connect')}</h4>
        <a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a>
        <a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={`mailto:${SITE.email}`} data-en={t('footer.email')} data-fr={tr.t('footer.email')}>{t('footer.email')}</a>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading mono" data-en={t('footer.reachOut')} data-fr={tr.t('footer.reachOut')}>{t('footer.reachOut')}</h4>
        <a href={`mailto:${SITE.email}`} class="mono">{SITE.email}</a>
        <span class="footer__muted mono">discord: {SITE.social.discord}</span>
        <span class="footer__muted">{SITE.location}</span>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="mono">&copy; {year} {SITE.author} — 7n4xt.</p>
      <p class="mono">
        <span data-en={t('footer.built')} data-fr={tr.t('footer.built')}>{t('footer.built')}</span>
        <span class="footer__heart">Astro</span>
        <span data-en={t('footer.palette')} data-fr={tr.t('footer.palette')}>{t('footer.palette')}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding-block: 4.5rem 2.5rem;
    background: linear-gradient(180deg, transparent, rgba(16, 19, 26, 0.6));
    scroll-margin-top: 0;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.4fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer__blurb p {
    color: var(--text-secondary);
    max-width: 40ch;
  }

  .footer__brand {
    color: var(--accent);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer__col a {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .footer__col a:hover {
    color: var(--accent);
  }

  .footer__heading {
    color: var(--text-primary);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .footer__muted {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .footer__heart {
    color: var(--nord8);
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
