---
import { SITE } from '../lib/site';
import { useTranslations } from '../lib/translate';

const { t } = useTranslations('en');
const tr = useTranslations('fr');
---

<section class="repos section" id="repos">
  <div class="container">
    <header class="section__head" data-reveal>
      <p class="section__label mono" data-en={t('repos.label')} data-fr={tr.t('repos.label')}>{t('repos.label')}</p>
      <h2 class="section__title" data-en={t('repos.title')} data-fr={tr.t('repos.title')}>{t('repos.title')}</h2>
      <p class="section__subtitle" data-en={t('repos.subtitle')} data-fr={tr.t('repos.subtitle')}>
        {t('repos.subtitle')}
      </p>
    </header>

    <div class="repos__bar mono" data-reveal>
      <span class="repos__bar-dot"></span>
      <span id="repos-count" data-en={t('repos.querying')} data-fr={tr.t('repos.querying')}>{t('repos.querying')}</span>
    </div>

    <div class="repos__grid" id="repos-grid" data-reveal>
      {Array.from({ length: 6 }).map(() => (
        <div class="repo card repo--skeleton">
          <div class="skeleton skeleton--title"></div>
          <div class="skeleton skeleton--line"></div>
          <div class="skeleton skeleton--line short"></div>
          <div class="skeleton skeleton--meta"></div>
        </div>
      ))}
    </div>

    <div class="repos__more" data-reveal>
      <a class="btn btn--ghost" href={SITE.social.github} target="_blank" rel="noopener">
        <span data-en={t('repos.viewAll')} data-fr={tr.t('repos.viewAll')}>{t('repos.viewAll')}</span>
        {SITE.username}
        <span data-en={t('repos.viewAllSuffix')} data-fr={tr.t('repos.viewAllSuffix')}>{t('repos.viewAllSuffix')}</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { watchLang } from '../lib/lang-store';

  const username = '7n4xt';
  const grid = document.getElementById('repos-grid')!;
  const countEl = document.getElementById('repos-count')!;

  // Mirrors of the dictionary entries used when rendering cards client-side.
  const T = {
    en: {
      noDesc: 'No description provided.',
      count: (n: number) => `${n} repos · ${username} · sorted by last push`,
      failed: '⚠ failed to reach GitHub API',
      errorTitle: 'could not fetch repositories — check network or rate limit.',
      errorCta: 'Open GitHub instead',
      stars: 'Stars',
      forks: 'Forks',
      fork: 'fork',
    },
    fr: {
      noDesc: 'Aucune description fournie.',
      count: (n: number) => `${n} dépôts · ${username} · triés par dernier push`,
      failed: '⚠ API GitHub injoignable',
      errorTitle: 'impossible de récupérer les dépôts — vérifiez le réseau ou la limite de requêtes.',
      errorCta: 'Ouvrir GitHub',
      stars: 'Étoiles',
      forks: 'Forks',
      fork: 'fork',
    },
  } as const;

  type Lang = keyof typeof T;
  type Repo = {
    name: string;
    description: string | null;
    language: string | null;
    stargazers_count: number;
    forks_count: number;
    fork: boolean;
    html_url: string;
  };

  let state: { kind: 'loading' } | { kind: 'ready'; repos: Repo[] } | { kind: 'error' } = {
    kind: 'loading',
  };
  let lang: Lang = 'en';

  function repoCard(r: Repo, t: (typeof T)['en']) {
    const language = r.language || 'misc';
    const langClass = language.toLowerCase().replace(/[^a-z0-9]+/g, '');
    return `
      <a href="${r.html_url}" target="_blank" rel="noopener" class="repo card">
        <div class="repo__head">
          <span class="repo__icon" aria-hidden="true">▰</span>
          <h3 class="repo__name">${r.name}</h3>
        </div>
        <p class="repo__desc">${r.description || t.noDesc}</p>
        <div class="repo__meta mono">
          <span class="repo__lang"><i class="repo__lang-dot lang-${langClass}"></i>${language}</span>
          <span title="${t.stars}">★ ${r.stargazers_count}</span>
          <span title="${t.forks}">⑂ ${r.forks_count}</span>
          ${r.fork ? `<span class="repo__forked">${t.fork}</span>` : ''}
        </div>
      </a>`;
  }

  function render() {
    const t = T[lang];
    if (state.kind === 'loading') return;

    if (state.kind === 'error') {
      countEl.textContent = t.failed;
      grid.innerHTML = `
        <div class="repos__error card">
          <p class="mono">${t.errorTitle}</p>
          <a class="btn btn--ghost" href="https://github.com/${username}" target="_blank" rel="noopener">${t.errorCta}</a>
        </div>`;
      return;
    }

    countEl.textContent = t.count(state.repos.length);
    grid.innerHTML = state.repos.map((r) => repoCard(r, t)).join('');
  }

  // Re-render on every language change (including the first paint).
  watchLang((next) => {
    lang = next;
    render();
  });

  async function loadRepos() {
    try {
      const res = await fetch(`https://api.github.com/users/${username}/repos?sort=updated&per_page=12`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      state = { kind: 'ready', repos: (await res.json()) as Repo[] };
    } catch {
      state = { kind: 'error' };
    }
    render();
  }

  loadRepos();
</script>

<style>
  .section__head {
    margin-bottom: 3rem;
    max-width: 760px;
  }

  .repos__bar {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    margin-bottom: 1.4rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: rgba(16, 19, 26, 0.5);
  }

  .repos__bar-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(163, 190, 140, 0.55); }
    70% { box-shadow: 0 0 0 7px rgba(163, 190, 140, 0); }
    100% { box-shadow: 0 0 0 0 rgba(163, 190, 140, 0); }
  }

  .repos__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .repo {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    color: inherit;
    min-height: 150px;
  }

  .repo:hover {
    transform: translateY(-4px);
  }

  .repo__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .repo__icon {
    color: var(--accent);
    font-size: 0.8rem;
  }

  .repo__name {
    font-size: 1.02rem;
    color: var(--text-primary);
    word-break: break-word;
  }

  .repo:hover .repo__name {
    color: var(--accent);
  }

  .repo__desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    flex: 1;
  }

  .repo__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .repo__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .repo__lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--nord3);
    display: inline-block;
  }

  .lang-javascript { background: #f1e05a; }
  .lang-go { background: #00add8; }
  .lang-html { background: #e34c26; }
  .lang-css { background: #563d7c; }
  .lang-python { background: #3572a5; }
  .lang-php { background: #4f5d95; }
  .lang-dockerfile { background: #384d54; }
  .lang-shell { background: #89e051; }
  .lang-sql { background: #e38c00; }

  .repo__forked {
    color: var(--warning);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .repos__more {
    margin-top: 2rem;
    text-align: center;
  }

  .repos__error {
    grid-column: 1 / -1;
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }

  .repos__error p {
    color: var(--text-secondary);
  }

  /* Skeleton */
  .repo--skeleton {
    animation: shimmer 1.4s ease-in-out infinite;
  }

  .skeleton {
    border-radius: var(--radius-sm);
    background: linear-gradient(90deg, rgba(76, 86, 106, 0.25) 25%, rgba(136, 192, 208, 0.15) 50%, rgba(76, 86, 106, 0.25) 75%);
    background-size: 200% 100%;
    animation: shimmer-bg 1.4s infinite;
  }

  .skeleton--title { width: 55%; height: 16px; }
  .skeleton--line { width: 100%; height: 12px; margin-top: 10px; }
  .skeleton--line.short { width: 70%; }
  .skeleton--meta { width: 40%; height: 12px; margin-top: 16px; }

  @keyframes shimmer-bg {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @media (max-width: 980px) {
    .repos__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 620px) {
    .repos__grid { grid-template-columns: 1fr; }
  }
</style>