---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const readingTime = Math.max(1, Math.ceil(post.body.length / 800));
---

<article class="post-card card" data-reveal>
  <div class="post-card__meta mono">
    <time datetime={post.data.pubDate.toISOString()}>
      {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
    </time>
    <span aria-hidden="true">·</span>
    <span>{readingTime} min read</span>
  </div>

  <h3 class="post-card__title">
    <a href={`/blog/${post.slug}`}>{post.data.title}</a>
  </h3>

  <p class="post-card__desc">{post.data.description}</p>

  <div class="post-card__tags">
    {post.data.tags.map((tag) => (
      <span class="post-card__tag mono">#{tag}</span>
    ))}
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.6rem;
    height: 100%;
  }

  .post-card:hover {
    transform: translateY(-4px);
  }

  .post-card__meta {
    display: flex;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .post-card__title {
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .post-card__title a {
    color: var(--text-primary);
  }

  .post-card__title a:hover {
    color: var(--accent);
  }

  .post-card__desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    flex: 1;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-card__tag {
    font-size: 0.72rem;
    color: var(--nord8);
    background: rgba(136, 192, 208, 0.1);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }
</style>
