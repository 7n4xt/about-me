---
import type { CollectionEntry } from 'astro:content';
import { useTranslations } from '../lib/translate';

interface Props {
  post: CollectionEntry<'blog'>;
  heading?: 'h2' | 'h3';
}

const { post, heading: Heading = 'h3' } = Astro.props;
const { t } = useTranslations('en');
const tr = useTranslations('fr');

const readingTime = Math.max(1, Math.ceil(post.body.length / 800));

const isoDate = post.data.pubDate.toISOString();
const dateEn = post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const dateFr = post.data.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article class="post-card card" data-reveal data-tags={JSON.stringify(post.data.tags)}>
  <div class="post-card__meta mono">
    <time datetime={isoDate} data-en={dateEn} data-fr={dateFr}>{dateEn}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime} <span data-en={t('blog.readTime')} data-fr={tr.t('blog.readTime')}>{t('blog.readTime')}</span></span>
  </div>

  <Heading class="post-card__title">
    <a href={`/blog/${post.slug}`}>{post.data.title}</a>
  </Heading>

  <p class="post-card__desc">{post.data.description}</p>

  <div class="post-card__tags">
    {post.data.tags.slice(0, 2).map((tag) => (
      <span class="post-card__tag">{tag}</span>
    ))}
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.6rem;
    height: 100%;
  }

  .post-card[hidden] {
    display: none;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .post-card__title {
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .post-card__title a {
    color: var(--text-primary);
  }

  .post-card__title a:hover {
    color: var(--accent);
  }

  .post-card__desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    flex: 1;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
  }

  .post-card__tag {
    font-size: 0.85rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .post-card__tag + .post-card__tag::before {
    content: '·';
    margin-inline-end: 0.75rem;
  }
</style>
