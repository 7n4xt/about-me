---
import LangSwitch from './LangSwitch.astro';
import { useTranslations } from '../lib/translate';

const { t } = useTranslations('en');
const tr = useTranslations('fr');

const links = [
  { href: '/#projects', key: 'nav.projects' },
  { href: '/#about', key: 'nav.about' },
  { href: '/blog', key: 'nav.blog' },
  { href: '/#contact', key: 'nav.contact' },
] as const;
---

<header class="nav" id="site-nav">
  <div class="container nav__inner">
    <a href="/#home" class="nav__brand" data-en-aria-label="Home" data-fr-aria-label="Accueil">
      <span class="nav__brand-prompt">$</span>
      <span class="nav__brand-name">7n4xt</span>
      <span class="nav__brand-cursor" aria-hidden="true">_</span>
    </a>

    <nav
      class="nav__links"
      id="primary-navigation"
      aria-label={t('nav.primary')}
      data-en-aria-label={t('nav.primary')}
      data-fr-aria-label={tr.t('nav.primary')}
    >
      {links.map((l) => (
        <a href={l.href} class="nav__link" data-en={t(l.key)} data-fr={tr.t(l.key)}>{t(l.key)}</a>
      ))}
      <LangSwitch />
    </nav>

    <button
      class="nav__toggle"
      aria-label={t('nav.toggleMenu')}
      data-en-aria-label={t('nav.toggleMenu')}
      data-fr-aria-label={tr.t('nav.toggleMenu')}
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav')!;
  const toggle = nav.querySelector<HTMLButtonElement>('.nav__toggle')!;
  const links = nav.querySelector<HTMLElement>('.nav__links')!;
  function closeMenu(returnFocus = false) {
    nav.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    if (returnFocus) toggle.focus();
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav.classList.contains('is-open')) closeMenu(true);
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !nav.contains(event.target)) closeMenu();
  });
  nav.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !nav.contains(event.relatedTarget)) closeMenu();
  });
  const desktop = window.matchMedia('(min-width: 861px)');
  desktop.addEventListener('change', () => closeMenu());
  const sectionLinks = Array.from(links.querySelectorAll<HTMLAnchorElement>('.nav__link'));
  function updateActive() {
    let active = location.pathname.startsWith('/blog') ? '/blog' : '';
    if (location.pathname === '/') {
      for (const id of ['projects', 'about', 'contact']) {
        const section = document.getElementById(id);
        if (section && section.getBoundingClientRect().top <= 160) active = `/#${id}`;
      }
    }
    sectionLinks.forEach(link => {
      if (link.getAttribute('href') === active) link.setAttribute('aria-current', active === '/blog' ? 'page' : 'location');
      else link.removeAttribute('aria-current');
    });
  }
  updateActive();

  function updateScrollState() {
    nav.classList.toggle('is-scrolled', window.scrollY > 12);
    updateActive();
  }
  updateScrollState();
  window.addEventListener('scroll', updateScrollState, { passive: true });

  toggle.addEventListener('click', () => {
    const open = nav.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  links.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      closeMenu();
    })
  );
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    isolation: isolate;
  }

  .nav::before {
    content: '';
    position: absolute;
    inset: 0 0 -48px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(23, 26, 34, 0.96) 0%, rgba(23, 26, 34, 0.9) 45%, rgba(23, 26, 34, 0) 100%);
    opacity: 0;
    transition: opacity var(--transition);
  }

  .nav.is-scrolled::before, .nav.is-open::before { opacity: 1; }

  @supports ((backdrop-filter: blur(20px)) or (-webkit-backdrop-filter: blur(20px))) {
    .nav::before {
      background: linear-gradient(to bottom, rgba(23, 26, 34, 0.76), rgba(23, 26, 34, 0.3));
      -webkit-backdrop-filter: blur(20px) saturate(140%);
      backdrop-filter: blur(20px) saturate(140%);
      -webkit-mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 100%);
      mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 100%);
    }
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .nav__brand-prompt {
    color: var(--nord14);
  }

  .nav__brand-cursor {
    color: var(--accent);
    animation: blink 1.1s steps(2, start) infinite;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav__link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-secondary);
    position: relative;
    padding-block: 0.65rem;
    min-height: 44px;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--accent);
    transition: width var(--transition);
  }

  .nav__link[aria-current], .nav__link:hover {
    color: var(--text-primary);
  }

  .nav__link[aria-current]::after, .nav__link:hover::after {
    width: 100%;
  }

  .nav__cta {
    padding: 0.5rem 1.1rem;
    font-size: 0.88rem;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
    align-items: center;
  }

  .nav__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text-primary);
    transition: transform var(--transition), opacity var(--transition);
  }

  .nav.is-open .nav__toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav.is-open .nav__toggle span:nth-child(2) {
    opacity: 0;
  }
  .nav.is-open .nav__toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .nav__toggle {
      display: flex;
    }

    .nav__links {
      position: fixed;
      top: var(--nav-height);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: rgba(16, 19, 26, 0.97);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0.75rem 1.25rem 1.5rem;
      max-height: calc(100dvh - var(--nav-height));
      overflow-y: auto;
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: all var(--transition);
    }

    .nav.is-open .nav__links {
      transform: none;
      opacity: 1;
      visibility: visible;
    }

    .nav__link {
      display: block;
      width: 100%;
      padding-block: 0.8rem;
      border-bottom: 1px solid rgba(76, 86, 106, 0.3);
      font-size: 1rem;
    }

    .nav__link::after {
      display: none;
    }

    .nav__cta {
      margin-top: 1rem;
      align-self: stretch;
      justify-content: center;
    }
  }
</style>
