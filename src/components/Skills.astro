---
import { useTranslations } from '../lib/translate';
import SkillIcon from './SkillIcon.astro';

const { t } = useTranslations('en');
const tr = useTranslations('fr');

const groups = [
  {
    name: 'networking',
    title: 'skills.groupNetworking',
    note: 'skills.groupNetworkingNote',
    items: ['skills.itemLinux', 'skills.itemCcna', 'skills.itemProxmox', 'skills.itemDocker', 'skills.itemServers', 'skills.itemTroubleshooting', 'skills.itemSelfHosting'],
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/>
        <path d="M12 7.5v3.5"/><path d="M5 16.5V14l4-2.5"/><path d="M19 16.5V14l-4-2.5"/><path d="M12 11l-4 2.5M12 11l4 2.5"/>
      </svg>`,
  },
  {
    name: 'security',
    title: 'skills.groupSecurity',
    note: 'skills.groupSecurityNote',
    items: ['skills.itemWazuh', 'skills.itemWireshark', 'skills.itemHardening', 'skills.itemHoneypots', 'skills.itemCtf'],
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2.5l7 2.5v6c0 4.5-3 8-7 9.5-4-1.5-7-5-7-9.5V5z"/>
        <path d="M9 12l2 2 4-4.5"/>
      </svg>`,
  },
  {
    name: 'code',
    title: 'skills.groupCode',
    note: 'skills.groupCodeNote',
    items: ['Python', 'Go', 'JavaScript', 'SQL', 'Bash'],
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 6l-6 6 6 6"/><path d="M16 6l6 6-6 6"/><path d="M13 4l-2 16"/>
      </svg>`,
  },
  {
    name: 'tools',
    title: 'skills.groupTools',
    note: 'skills.groupToolsNote',
    items: ['Git', 'Proxmox', 'Grafana', 'Pi-hole', 'Docker', 'VSCode'],
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15 4.6a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.13.47.5.86 1.03 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.51 1z"/>
      </svg>`,
  },
] as const;

const label = (key: string) => (/^skills[.A-Z]/.test(key) ? t(key as Parameters<typeof t>[0]) : key);
const labelFr = (key: string) => (/^skills[.A-Z]/.test(key) ? tr.t(key as Parameters<typeof t>[0]) : key);
---

<section class="skills section" id="skills">
  <div class="container">
    <header class="section__head" data-reveal>
      <p class="section__label mono" data-en={t('skills.label')} data-fr={tr.t('skills.label')}>{t('skills.label')}</p>
      <h2 class="section__title" data-en={t('skills.title')} data-fr={tr.t('skills.title')}>{t('skills.title')}</h2>
      <p class="section__subtitle" data-en={t('skills.subtitle')} data-fr={tr.t('skills.subtitle')}>
        {t('skills.subtitle')}
      </p>
    </header>

    <div class="skills__grid">
      {groups.map((g) => (
        <div class={`skill-group skill-group--${g.name}`}>
          <div class="skill-group__head">
            <span class="skill-group__icon" aria-hidden="true" set:html={g.icon}></span>
            <div>
              <h3 class="skill-group__title" data-en={label(g.title)} data-fr={labelFr(g.title)}>{label(g.title)}</h3>
              <span class="skill-group__note" data-en={label(g.note)} data-fr={labelFr(g.note)}>{label(g.note)}</span>
            </div>
          </div>
          {g.name === 'networking' && <div class="skill-stack" aria-hidden="true">
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="3" width="16" height="7" rx="2"/><rect x="4" y="14" width="16" height="7" rx="2"/><path d="M7 6.5h2m-2 11h2M12 10v4"/></svg>Proxmox</span>
            <i></i><span>Linux</span><i></i><span>Services</span>
          </div>}
          <ul class="skill-group__list">
            {g.items.map((item) => (
              <li class="skill-group__item">
                <SkillIcon name={item} />
                <span data-en={label(item)} data-fr={labelFr(item)}>{label(item)}</span>
              </li>
            ))}
          </ul>
          {g.name === 'networking' && <a class="skill-group__proof" href="/blog/building-a-homelab"><span data-en="Inside my homelab" data-fr="Dans mon homelab">Inside my homelab</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>}
          {g.name === 'security' && <a class="skill-group__proof" href="/blog/wazuh-honeypot-siem"><span data-en="My Wazuh & honeypot lab" data-fr="Mon lab Wazuh et honeypot">My Wazuh & honeypot lab</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section__head {
    margin-bottom: 3.5rem;
    max-width: 760px;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .skill-group {
    --group-accent: var(--nord8);
    grid-column: span 7;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    position: relative;
    overflow: hidden;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--bg-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .skill-group--networking { background: radial-gradient(ellipse at top right, rgba(136,192,208,0.09), transparent 65%), var(--bg-raised); }
  .skill-group--security { grid-column: span 5; --group-accent: var(--nord14); }
  .skill-group--code { grid-column: span 5; --group-accent: var(--nord13); }
  .skill-group--tools { --group-accent: var(--nord15); }

  .skill-group__head {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .skill-group__icon {
    color: var(--group-accent);
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
  }

  .skill-group__icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .skill-group__title {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.2;
  }

  .skill-group__note {
    color: var(--text-muted);
    display: block;
    font-size: 0.9rem;
    margin-top: 0.4rem;
  }

  .skill-group__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .skill-group__item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-primary);
    font-size: 0.875rem;
    padding: 0.5rem 0.85rem;
    line-height: 1.5;
    border-radius: var(--radius-sm);
    background: rgba(216,222,233,0.045);
    border: 1px solid var(--border-subtle);
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .skill-group__proof { display: inline-flex; align-items: center; gap: 0.75rem; min-height: 44px; padding-top: 0.75rem; margin-top: auto; color: var(--group-accent); font-size: 0.9rem; }
  .skill-group__proof svg { width: 18px; height: 18px; flex-shrink: 0; }
  .skill-group__proof:hover { color: var(--text-primary); }
  .skill-stack { display: flex; align-items: center; width: 100%; margin-bottom: 1.75rem; color: var(--group-accent); font: 0.8rem var(--font-mono); }
  .skill-stack > span { display: flex; align-items: center; gap: 0.5rem; padding: 0.7rem; border: 1px solid var(--border-strong); border-radius: 12px; background: var(--bg-base); }
  .skill-stack svg { width: 20px; height: 20px; }
  .skill-stack i { height: 1px; flex: 1; min-width: 0.5rem; background: var(--border-strong); }

  @media (max-width: 820px) {
    .skills__grid {
      grid-template-columns: 1fr;
    }
    .skill-group { grid-column: auto; }
  }
  @media (max-width: 400px) {
    .skill-stack { font-size: 0.7rem; }
    .skill-stack > span { padding: 0.5rem; }
    .skill-stack svg { display: none; }
  }
</style>
