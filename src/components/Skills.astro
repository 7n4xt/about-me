---
const groups = [
  {
    name: 'networking',
    title: 'Networking & Infrastructure',
    note: 'the layers I live in',
    items: ['Linux administration', 'CCNA (in progress)', 'Proxmox / virtualization', 'Docker & containers', 'Server administration', 'Network troubleshooting', 'Self-hosting'],
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/>
        <path d="M12 7.5v3.5"/><path d="M5 16.5V14l4-2.5"/><path d="M19 16.5V14l-4-2.5"/><path d="M12 11l-4 2.5M12 11l4 2.5"/>
      </svg>`,
  },
  {
    name: 'security',
    title: 'Security',
    note: 'break it to defend it',
    items: ['Wazuh SIEM', 'Wireshark / packet analysis', 'System hardening', 'Honeypots', 'CTF (HackTheBox, Root-Me)'],
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2.5l7 2.5v6c0 4.5-3 8-7 9.5-4-1.5-7-5-7-9.5V5z"/>
        <path d="M9 12l2 2 4-4.5"/>
      </svg>`,
  },
  {
    name: 'code',
    title: 'Languages',
    note: 'tools of the trade',
    items: ['Python', 'Go', 'JavaScript', 'SQL', 'Bash'],
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 6l-6 6 6 6"/><path d="M16 6l6 6-6 6"/><path d="M13 4l-2 16"/>
      </svg>`,
  },
  {
    name: 'tools',
    title: 'Tools',
    note: 'daily drivers',
    items: ['Git', 'Proxmox', 'Grafana', 'Pi-hole', 'Docker', 'VSCode'],
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15 4.6a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.13.47.5.86 1.03 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.51 1z"/>
      </svg>`,
  },
];
---

<section class="skills section" id="skills">
  <div class="container">
    <header class="section__head" data-reveal>
      <p class="section__label mono">// skills</p>
      <h2 class="section__title">A full-stack infrastructure toolkit</h2>
      <p class="section__subtitle">
        The tools and technologies I work with daily — focused on the layers that make
        networks and infrastructure secure and resilient.
      </p>
    </header>

    <div class="skills__grid">
      {groups.map((g, i) => (
        <div class="skill-group card" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <div class="skill-group__head">
            <span class="skill-group__icon" aria-hidden="true" set:html={g.icon}></span>
            <div>
              <h3 class="skill-group__title">{g.title}</h3>
              <span class="skill-group__note mono">{g.note}</span>
            </div>
          </div>
          <ul class="skill-group__list">
            {g.items.map((item, j) => (
              <li class="skill-group__item" style={`--item-order:${j}`}>
                <span class="skill-group__index mono">{String(j + 1).padStart(2, '0')}</span>
                {item}
              </li>
            ))}
          </ul>
          <div class="skill-group__foot mono">
            <span>{g.items.length} in this category</span>
            <span class="skill-group__foot-dots" aria-hidden="true">▓▓▓░</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section__head {
    margin-bottom: 3.5rem;
    max-width: 760px;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .skill-group {
    padding: 1.6rem;
    position: relative;
    overflow: hidden;
  }

  .skill-group::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent 70%);
    opacity: 0;
    transition: opacity var(--transition);
  }

  .skill-group:hover::before {
    opacity: 1;
  }

  .skill-group:hover {
    transform: translateY(-4px);
  }

  .skill-group__head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.2rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .skill-group__icon {
    color: var(--accent);
    width: 2.3rem;
    height: 2.3rem;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    background: rgba(136, 192, 208, 0.08);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .skill-group__icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .skill-group__title {
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .skill-group__note {
    color: var(--text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .skill-group__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .skill-group__item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--text-secondary);
    font-size: 0.98rem;
    transition: color var(--transition), padding var(--transition);
  }

  .skill-group__item:hover {
    color: var(--text-primary);
    padding-left: 0.25rem;
  }

  .skill-group__index {
    color: var(--nord3);
    font-size: 0.78rem;
    min-width: 2ch;
  }

  .skill-group__foot {
    margin-top: 1.3rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .skill-group__foot-dots {
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  @media (max-width: 820px) {
    .skills__grid {
      grid-template-columns: 1fr;
    }
  }
</style>