---
import { SITE } from '../lib/site';
import { useTranslations } from '../lib/translate';

const { t } = useTranslations('en');
const tr = useTranslations('fr');

const timeline = [
  { period: 'about.tl1Period', role: 'about.tl1Role', org: 'about.tl1Org', desc: 'about.tl1Desc', color: 'accent' },
  { period: 'about.tl2Period', role: 'about.tl2Role', org: 'about.tl2Org', desc: 'about.tl2Desc', color: 'success' },
  { period: 'about.tl3Period', role: 'about.tl3Role', org: 'about.tl3Org', desc: 'about.tl3Desc', color: 'warning' },
] as const;
---

<section class="about section" id="about">
  <div class="container">
    <header class="section__head" data-reveal>
      <p class="section__label mono" data-en={t('about.label')} data-fr={tr.t('about.label')}>{t('about.label')}</p>
      <h2 class="section__title" data-en={t('about.title')} data-fr={tr.t('about.title')}>{t('about.title')}</h2>
      <p class="section__subtitle" data-en={t('about.subtitle')} data-fr={tr.t('about.subtitle')}>
        {t('about.subtitle')}
      </p>
    </header>

    <div class="about__grid">
      <div class="about__lead card" data-reveal>
        <div class="about__lead-head mono">
          <span class="about__lead-label">$ cat /etc/profile.d/me.sh</span>
        </div>
        <p>
          <span data-en={t('about.lead1a')} data-fr={tr.t('about.lead1a')}>{t('about.lead1a')}</span>
          <strong>Libya</strong>
          <span data-en={t('about.lead1b')} data-fr={tr.t('about.lead1b')}>{t('about.lead1b')}</span>
          <strong>Marseille</strong><span data-en={t('about.lead1c')} data-fr={tr.t('about.lead1c')}>{t('about.lead1c')}</span>
          <strong>CCNA</strong><span data-en={t('about.lead1d')} data-fr={tr.t('about.lead1d')}>{t('about.lead1d')}</span>
          <span class="mono" data-en="a Proxmox box running Wazuh, Pi-hole, Grafana, and more" data-fr="une machine Proxmox qui fait tourner Wazuh, Pi-hole, Grafana, et plus">a Proxmox box running Wazuh, Pi-hole, Grafana, and more</span><span data-en={t('about.lead1e')} data-fr={tr.t('about.lead1e')}>{t('about.lead1e')}</span>
        </p>
        <p data-en={t('about.lead2')} data-fr={tr.t('about.lead2')}>{t('about.lead2')}</p>
        <div class="about__facts mono">
          <div>
            <span class="about__fact-k" data-en={t('about.factLocation')} data-fr={tr.t('about.factLocation')}>{t('about.factLocation')}</span>
            <span>{SITE.location}</span>
          </div>
          <div>
            <span class="about__fact-k" data-en={t('about.factOrigin')} data-fr={tr.t('about.factOrigin')}>{t('about.factOrigin')}</span>
            <span data-en={t('about.factOriginValue')} data-fr={tr.t('about.factOriginValue')}>{t('about.factOriginValue')}</span>
          </div>
          <div>
            <span class="about__fact-k" data-en={t('about.factCoffee')} data-fr={tr.t('about.factCoffee')}>{t('about.factCoffee')}</span>
            <span data-en={t('about.factCoffeeValue')} data-fr={tr.t('about.factCoffeeValue')}>{t('about.factCoffeeValue')}</span>
          </div>
          <div>
            <span class="about__fact-k" data-en={t('about.factStatus')} data-fr={tr.t('about.factStatus')}>{t('about.factStatus')}</span>
            <span data-en={t('about.factStatusValue')} data-fr={tr.t('about.factStatusValue')}>{t('about.factStatusValue')}</span>
          </div>
        </div>
      </div>

      <div class="about__timeline" data-reveal>
        {timeline.map((item) => (
          <div class="tl-item">
            <div class={`tl-dot tl-dot--${item.color}`} aria-hidden="true"></div>
            <div class="tl-card card">
              <span class="tl-period mono" data-en={t(item.period)} data-fr={tr.t(item.period)}>{t(item.period)}</span>
              <h3 class="tl-role" data-en={t(item.role)} data-fr={tr.t(item.role)}>{t(item.role)}</h3>
              <span class="tl-org mono" data-en={t(item.org)} data-fr={tr.t(item.org)}>{t(item.org)}</span>
              <p data-en={t(item.desc)} data-fr={tr.t(item.desc)}>{t(item.desc)}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section__head {
    margin-bottom: 3.5rem;
    max-width: 760px;
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    align-items: start;
  }

  .about__lead {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about__lead-head {
    color: var(--accent);
    font-size: 0.8rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.8rem;
  }

  .about__lead p {
    color: var(--text-secondary);
  }

  .about__lead strong {
    color: var(--text-primary);
  }

  .about__facts {
    margin-top: 0.5rem;
    border-top: 1px dashed var(--border-subtle);
    padding-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .about__facts div {
    display: flex;
    gap: 1rem;
  }

  .about__fact-k {
    color: var(--accent);
    width: 8.5rem;
    flex-shrink: 0;
  }

  .about__facts span:not(.about__fact-k) {
    color: var(--text-secondary);
  }

  /* Timeline */
  .about__timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about__timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(180deg, var(--nord8), var(--nord10), transparent);
  }

  .tl-item {
    position: relative;
    padding-left: 2.2rem;
  }

  .tl-dot {
    position: absolute;
    left: 0;
    top: 1.1rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg-base);
    border: 3px solid currentColor;
    box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.2);
  }

  .tl-dot--accent { color: var(--accent); }
  .tl-dot--success { color: var(--success); }
  .tl-dot--warning { color: var(--warning); }
  .tl-dot--danger { color: var(--danger); }

  .tl-card {
    padding: 1.3rem 1.5rem;
  }

  .tl-period {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .tl-role {
    font-size: 1.1rem;
    margin-block: 0.3rem 0.1rem;
  }

  .tl-org {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .tl-card p {
    margin-top: 0.6rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .about__facts div { flex-wrap: wrap; gap: 0.15rem 0.75rem; }
    .about__fact-k { width: 100%; }
    .about__lead-head { overflow-wrap: anywhere; }
  }
</style>
