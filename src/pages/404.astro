---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — page not found">
  <section class="nf section">
    <div class="container">
      <div class="nf__terminal card">
        <div class="nf__bar mono">
          <span>error.log</span>
        </div>
        <pre class="nf__code mono">
<span class="nf__line">[err] request failed</span>
<span class="nf__line">[err] 404: page not found</span>
<span class="nf__line">&nbsp;</span>
<span class="nf__hint">$ suggest an alternative route ...</span>
        </pre>
        <div class="nf__actions">
          <a href="/" class="btn btn--primary">Go home</a>
          <a href="/blog" class="btn btn--ghost">Read the blog</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf {
    min-height: 80svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-height) + 2rem);
  }

  .nf .container {
    max-width: 640px;
  }

  .nf__terminal {
    overflow: hidden;
  }

  .nf__bar {
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.8rem;
    background: rgba(16, 19, 26, 0.5);
  }

  .nf__code {
    padding: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-secondary);
    overflow-x: auto;
  }

  .nf__line:first-child {
    color: var(--danger);
  }

  .nf__hint {
    color: var(--nord8);
  }

  .nf__actions {
    display: flex;
    gap: 1rem;
    padding: 0 1.5rem 1.5rem;
    flex-wrap: wrap;
  }
</style>