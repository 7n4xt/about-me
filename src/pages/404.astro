---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../lib/translate';

const { t } = useTranslations('en');
const tr = useTranslations('fr');
---

<Layout titleKey="meta.404Title">
  <section class="nf section">
    <div class="container">
      <div class="nf__terminal card">
        <div class="nf__bar mono">
          <span>error.log</span>
        </div>
        <pre class="nf__code mono">
<span class="nf__line" data-en={t('nf.line1')} data-fr={tr.t('nf.line1')}>{t('nf.line1')}</span>
<span class="nf__line" data-en={t('nf.line2')} data-fr={tr.t('nf.line2')}>{t('nf.line2')}</span>
<span class="nf__line">&nbsp;</span>
<span class="nf__hint" data-en={t('nf.hint')} data-fr={tr.t('nf.hint')}>{t('nf.hint')}</span>
        </pre>
        <div class="nf__actions">
          <a href="/" class="btn btn--primary" data-en={t('nf.home')} data-fr={tr.t('nf.home')}>{t('nf.home')}</a>
          <a href="/blog" class="btn btn--ghost" data-en={t('nf.blog')} data-fr={tr.t('nf.blog')}>{t('nf.blog')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf {
    min-height: 80svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-height) + 2rem);
  }

  .nf .container {
    max-width: 640px;
  }

  .nf__terminal {
    overflow: hidden;
  }

  .nf__bar {
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.8rem;
    background: rgba(16, 19, 26, 0.5);
  }

  .nf__code {
    padding: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-secondary);
    overflow-x: auto;
  }

  .nf__line:first-child {
    color: var(--danger);
  }

  .nf__hint {
    color: var(--nord8);
  }

  .nf__actions {
    display: flex;
    gap: 1rem;
    padding: 0 1.5rem 1.5rem;
    flex-wrap: wrap;
  }
</style>