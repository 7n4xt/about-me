---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../lib/translate';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const { t } = useTranslations('en');
const tr = useTranslations('fr');
---

<Layout titleKey="meta.blogTitle" descKey="meta.blogDesc">
  <section class="blog section">
    <div class="container">
      <header class="blog__head" data-reveal>
        <a href="/" class="blog__back mono" data-en={t('blog.backHome')} data-fr={tr.t('blog.backHome')}>{t('blog.backHome')}</a>
        <h1 class="blog__title" data-en={t('blog.title')} data-fr={tr.t('blog.title')}>{t('blog.title')}</h1>
        <p class="blog__subtitle" data-en={t('blog.subtitle')} data-fr={tr.t('blog.subtitle')}>
          {t('blog.subtitle')}
        </p>
      </header>

      <div class="blog__tools" id="blog-tools" hidden>
        <div class="blog__topic">
          <label for="blog-topic" data-en={t('blog.topic')} data-fr={tr.t('blog.topic')}>{t('blog.topic')}</label>
          <select id="blog-topic" aria-controls="blog-grid">
            <option value="" data-en={t('blog.allTopics')} data-fr={tr.t('blog.allTopics')}>{t('blog.allTopics')}</option>
            {allTags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
        </div>
        <p class="blog__count" id="blog-count" role="status" aria-atomic="true"></p>
      </div>

      <div class="blog__grid" id="blog-grid" data-reveal>
        {posts.map((post) => (
          <BlogCard post={post} heading="h2" />
        ))}
      </div>

      {posts.length === 0 && (
        <p class="blog__empty mono" data-en={t('blog.empty')} data-fr={tr.t('blog.empty')}>{t('blog.empty')}</p>
      )}
    </div>
  </section>
</Layout>

<script>
  const topic = document.querySelector<HTMLSelectElement>('#blog-topic')!;
  const cards = [...document.querySelectorAll<HTMLElement>('#blog-grid .post-card')];
  const count = document.getElementById('blog-count')!;

  function filterPosts() {
    let visible = 0;
    for (const card of cards) {
      const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
      card.hidden = topic.value !== '' && !tags.includes(topic.value);
      if (!card.hidden) visible++;
    }
    // Both interface languages use “article” / “articles”.
    count.textContent = `${visible} ${visible === 1 ? 'article' : 'articles'}`;
  }

  topic.addEventListener('change', filterPosts);
  filterPosts();
  document.getElementById('blog-tools')!.hidden = false;
</script>

<style>
  .blog__head {
    margin-bottom: 2.5rem;
  }

  .blog__back {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }

  .blog__back:hover {
    color: var(--accent);
  }

  .blog__title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin-bottom: 0.75rem;
  }

  .blog__subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 60ch;
  }

  .blog__tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.25rem;
    margin-bottom: 2rem;
    border-block: 1px solid var(--border-subtle);
  }

  .blog__tools[hidden] {
    display: none;
  }

  .blog__topic {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: 100%;
  }

  label,
  .blog__count {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  select {
    min-height: 44px;
    max-width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--text-primary);
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .blog__empty {
    color: var(--text-muted);
    padding: 3rem 0;
  }

  @media (max-width: 620px) {
    .blog__grid { grid-template-columns: 1fr; }
  }
</style>
